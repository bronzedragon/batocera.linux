+		if (options.netLinkRole == "join")
+		{
+			// Only numeric IPv4 reaches the shell. Python validates each octet.
+			if (options.netLinkPeer.empty() || options.netLinkPeer.find_first_not_of("0123456789.") != std::string::npos)
+				return "";
+			command += " --peer " + options.netLinkPeer;
+		}
+		return command + " --launch";
+	}
